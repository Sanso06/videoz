<p>Posted by: <a href="/users/{{post.authorId}}">{{post.author}}</a></p>

<p>Posted on: <time>{{formatDate post.createdAt}}</time></p>

<video controls preload="metadata">
    <source src="{{post.video}}" type="video/mp4">
    Your browser does not support the video tag.
</video>

<p class="post-description">{{post.description}}</p>

<div class="post-actions">
    {{#if isLoggedIn}}
        <form action="/posts/{{post.id}}/like" method="post" class="inline-form">
            <button type="submit" class="btn btn-small {{#if userHasLiked}}btn-liked{{/if}}">
                {{#if userHasLiked}}Unlike{{else}}Like{{/if}}
            </button>
        </form>
    {{else}}
        <a class="btn btn-small" href="/login">Log in to like</a>
    {{/if}}

    <span class="like-count">{{pluralize post.likeCount "like" "likes"}}</span>

    {{#if isOwner}}
        <form action="/posts/{{post.id}}/delete" method="post" class="inline-form"
              onsubmit="return confirm('Delete this post? This cannot be undone.');">
            <button type="submit" class="btn btn-small btn-danger">Delete Post</button>
        </form>
    {{/if}}
</div>

<section id="comments" class="card">
    <h2>Comments ({{commentCount}})</h2>

    {{#each comments}}
        {{> comment}}
    {{else}}
        <p>No comments yet. Be the first to comment!</p>
    {{/each}}

    {{#if isLoggedIn}}
        <form id="commentForm" action="/posts/{{post.id}}/comment" method="post">
            <label for="commentText">Add a comment:</label>
            <textarea id="commentText" name="text" placeholder="Share your thoughts..." required maxlength="2000"></textarea>
            <button type="submit" class="btn">Comment</button>
        </form>
    {{else}}
        <p><a href="/login">Log in</a> to leave a comment.</p>
    {{/if}}
</section>
