<article class="post-card">
    <a class="post-card-link" href="/posts/{{id}}">
        {{#if (isImage thumbnail)}}
            {{!-- Normal case: a real JPEG captured from the video at upload. --}}
            <img class="post-thumb" src="{{thumbnail}}" alt="Thumbnail for {{title}}">
        {{else}}
            {{!-- Fallback for posts saved without a generated thumbnail.
                  preload="auto" is required here: with "metadata" the browser
                  cannot decode a frame from an MP4 whose index sits at the end
                  of the file, and the card renders as a black box. --}}
            <video class="post-thumb" src="{{thumbnail}}" preload="auto"
                   muted playsinline tabindex="-1"></video>
        {{/if}}
        <h3 class="post-card-title">{{title}}</h3>
    </a>
    <p class="post-card-meta">
        by <a href="/users/{{authorId}}">{{author}}</a> &middot; {{formatDate createdAt}}
    </p>
    <p class="post-card-desc">{{truncate description 90}}</p>
    <p class="post-card-stats">
        {{pluralize likeCount "like" "likes"}} &middot;
        {{pluralize commentCount "comment" "comments"}}
    </p>
</article>
