# Copy to .env and fill in for your own machine, or export these in your shell.
# Anything left unset falls back to the development defaults in conf/config.js.
#
# Note: this project does not load .env automatically (no dotenv dependency).
# Either export the variables before starting the server:
#
#   DB_PASSWORD=yourpassword npm start
#
# or prefix a single command, as the README shows.

# --- MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=videoz_db

# --- Sessions ---
# Use a long random string in any real deployment.
SESSION_SECRET=

# --- Runtime ---
# Set to "production" to serve secure cookies and hide stack traces.
NODE_ENV=development
PORT=3000
