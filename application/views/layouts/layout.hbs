<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="icon" href="/public/favicon.ico" sizes="70x70" type="image/ico">
    <link rel="stylesheet" type="text/css" href="/public/css/style.css" />
    {{#if useValidation}}
    <script defer src="/public/js/validation.js"></script>
    {{/if}}
    {{#if useLoginValidation}}
    <script defer src="/public/js/login.js"></script>
    {{/if}}
    {{#if usePostVideo}}
    <script defer src="/public/js/postvideo.js"></script>
    {{/if}}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {{> navbar}}
    {{> banner}}
    <main id="main">
      {{> flash}}
      {{{body}}}
    </main>
    {{> footer}}
  </body>
</html>
